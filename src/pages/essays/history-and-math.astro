---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { essays } from "../../data/essays";
import { readingMinutes } from "../../lib/reading-time";

const essay = essays.find((item) => item.slug === "history-and-math")!;
const readMinutes = readingMinutes(essay.body);
---

<BaseLayout
  title="历史与数学 — bionickernel.com" description="观点：学一个领域绕不开两样东西——它的发展史与它依赖的数学。历史给出坐标，数学给出边界。" canonical="https://bionickernel.com/essays/history-and-math.html" active="essay"
  ogTitle="历史与数学 | bionickernel.com"
  ogDescription="历史给出坐标，数学给出边界；缺一项，理解停在「会用」。"
  ogType="article"
>
<style is:global>
.prose {
        margin-top: 0.5rem;
        max-width: 42rem;
      }
      .prose p {
        margin-top: 0.95rem;
        color: var(--dim);
        font-size: 0.97rem;
        line-height: 1.9;
        text-wrap: pretty;
      }
      .prose strong {
        color: var(--fg);
        font-weight: 600;
      }
      .prose em {
        color: var(--fg);
        font-style: normal;
        border-bottom: 1px solid var(--line-strong);
      }
      .prose a {
        color: var(--fg);
        text-decoration: none;
        border-bottom: 1px solid currentColor;
      }
      .prose a:hover {
        color: var(--accent-text);
      }
      .prose code {
        padding: 0.1rem 0.35rem;
        border: 1px solid var(--border);
        border-radius: 5px;
        background: var(--bg-elev);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.86em;
        color: var(--fg);
      }
      .prose ul,
      .prose ol {
        margin-top: 0.9rem;
        padding-left: 1.15rem;
        color: var(--dim);
        font-size: 0.97rem;
        line-height: 1.9;
      }
      .prose li + li {
        margin-top: 0.45rem;
      }
      .prose li::marker {
        color: var(--accent-text);
      }
      .byline {
        margin-top: 0.9rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 0.9rem;
        font-size: 0.8rem;
        color: var(--faint);
      }
      .byline span {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
      }
      .byline span + span::before {
        content: "";
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: var(--faint);
      }
      .essay-body section {
        margin-top: 2.2rem;
      }
      .essay-body .sec-head {
        margin-bottom: 0.35rem;
      }
      .essay-body h2 {
        font-size: 1.16rem;
      }
      .next {
        margin-top: 2.6rem;
        padding-top: 1.2rem;
        border-top: 1px solid var(--line);
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
      }
</style>

<p class="mono">Essay</p>
        <h1>{essay.title}</h1>
        <p class="byline">
          <span>隔壁老木箱</span>
          <span>{essay.date}</span>
          <span>约 {readMinutes} 分钟</span>
        </p>

        <div class="prose essay-body">
          <Fragment set:html={essay.body} />
        </div>

        <div class="next">
          <a class="btn" href="/books/">推荐书籍</a>
          <a class="btn" href="/#contact">讨论这个观点</a>
        </div>
</BaseLayout>
