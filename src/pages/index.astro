---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="bionickernel.com" description="bionickernel.com — 个人技术站点：推荐书籍、皮肤渲染与工具推荐。" canonical="https://bionickernel.com/" active="home">
<style is:global>
.hero {
        position: relative;
        padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.8fr);
        gap: clamp(1.5rem, 4vw, 3rem);
        align-items: end;
      }
      .hero-art {
        --art-1: #16243a;
        --art-2: #1e3a55;
        --art-3: #2f6d92;
        --art-4: #66c2f2;
        position: absolute;
        inset: -3.5rem -4rem -1.5rem -4rem;
        z-index: 0;
        pointer-events: none;
        opacity: 0.9;
        background:
          radial-gradient(70% 80% at 18% 22%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 62%),
          radial-gradient(60% 70% at 82% 72%, color-mix(in srgb, var(--accent) 7%, transparent), transparent 66%);
        -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 42%, transparent 92%),
          linear-gradient(90deg, transparent 0%, #000 10%, #000 84%, transparent 100%);
        -webkit-mask-composite: source-in;
        mask-image: linear-gradient(180deg, #000 0%, #000 42%, transparent 92%),
          linear-gradient(90deg, transparent 0%, #000 10%, #000 84%, transparent 100%);
        mask-composite: intersect;
      }
      .hero-art canvas {
        display: block;
        width: 100%;
        height: 100%;
      }
      .hero-art.no-webgl canvas {
        display: none;
      }
      .hero-copy,
      .hero .panel {
        position: relative;
        z-index: 1;
      }
      @media (prefers-color-scheme: light) {
        .hero-art {
          --art-1: #f3f5f7;
          --art-2: #e2ebf2;
          --art-3: #b9d3e4;
          --art-4: #6aaad4;
          opacity: 0.55;
        }
      }
      .hero h1 {
        margin-top: 0.9rem;
        font-size: clamp(2.2rem, 5.4vw, 3.6rem);
        line-height: 1.04;
      }
      .hero h1 .dot {
        color: var(--accent-text);
      }
      .lede {
        margin-top: 1.1rem;
        max-width: 34rem;
        color: var(--dim);
        font-size: clamp(0.97rem, 1.5vw, 1.05rem);
        text-wrap: pretty;
      }
      .lede .en {
        display: block;
        margin-top: 0.45rem;
        font-size: 0.88rem;
        color: var(--faint);
      }
      .actions {
        margin-top: 1.9rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
      }
      .panel {
        border: 1px solid var(--line-strong);
        border-radius: 16px;
        background: var(--bg-elev);
        background: linear-gradient(160deg, color-mix(in srgb, var(--bg-elev) 92%, var(--accent)), var(--bg-elev));
        padding: 1.1rem 1.2rem 1.2rem;
      }
      .panel .mono {
        display: block;
        margin-bottom: 0.85rem;
      }
      .panel dl {
        display: grid;
        gap: 0.65rem;
      }
      .panel div {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        padding-bottom: 0.65rem;
        border-bottom: 1px dashed var(--line);
      }
      .panel div:last-child {
        border-bottom: 0;
        padding-bottom: 0;
      }
      .panel dt {
        font-size: 0.82rem;
        color: var(--dim);
      }
      .panel dd {
        margin: 0;
        font-size: 0.82rem;
        color: var(--fg);
        text-align: right;
      }
      .contact {
        margin-top: 1.4rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.7rem;
      }
      .contact .note {
        margin-left: auto;
        font-size: 0.78rem;
        color: var(--faint);
      }
      @media (max-width: 900px) {
        .hero {
          grid-template-columns: minmax(0, 1fr);
          align-items: start;
        }
        .hero-art {
          inset: -1.75rem -1.25rem 0;
          opacity: 0.62;
        }
        .panel {
          max-width: 28rem;
        }
      }
      @media (max-width: 640px) {
        .contact .note {
          margin-left: 0;
        }
      }
</style>

<div class="hero">
          <div class="hero-art" aria-hidden="true"><canvas data-fluid></canvas></div>
          <div class="hero-copy">
            <p class="mono"><span class="cjk">隔壁老木箱</span> · Personal site</p>
            <h1>bionickernel<span class="dot">.</span>com</h1>
            <p class="lede">
              记录读过的书、做过的渲染和正在维护的项目。内容优先，尽量给出处。
              <span class="en">A personal site for books, renders, and long-running notes.</span>
            </p>
            <div class="actions">
              <a class="btn primary" href="/books/">推荐书籍</a>
              <a class="btn" href="/skins/">皮肤渲染</a>
              <a class="btn" href="https://github.com/GBLMX" target="_blank" rel="noopener">
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path
                    d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
                  />
                </svg>
                GitHub
              </a>
            </div>
          </div>

          <aside class="panel" aria-label="站点概览">
            <span class="mono">Overview</span>
            <dl>
              <div><dt>内容</dt><dd>书籍 · 渲染 · 推荐</dd></div>
              <div><dt>形态</dt><dd>静态页面</dd></div>
              <div><dt>跟踪</dt><dd>无统计脚本</dd></div>
              <div><dt>协议</dt><dd>HTTP/2 · HTTP/3</dd></div>
              <div><dt>托管</dt><dd>阿里云 ECS</dd></div>
            </dl>
          </aside>
        </div>

        <section id="sections">
          <div class="sec-head">
            <span class="num" aria-hidden="true">01</span>
            <h2>站内导航</h2>
            <span class="hint">按主题组织，持续补充</span>
          </div>
          <div class="cards">
            <a class="card" href="/books/">
              <div class="top">
                <span class="mono">Books</span>
                <span class="arrow" aria-hidden="true">→</span>
              </div>
              <h3>推荐书籍</h3>
              <p>读过、会回头查的书。附收录标准和条目格式。</p>
              <div class="meta"><span>书单</span><span>读书笔记</span></div>
            </a>
            <a class="card" href="/skins/">
              <div class="top">
                <span class="mono">Renders</span>
                <span class="arrow" aria-hidden="true">→</span>
              </div>
              <h3>皮肤渲染</h3>
              <p>Minecraft 皮肤的可交互 3D 预览。</p>
              <div class="meta"><span>3D</span><span>WebGL</span></div>
            </a>
            <a class="card" href="/essays/history-and-math.html">
              <div class="top">
                <span class="mono">Essay</span>
                <span class="arrow" aria-hidden="true">→</span>
              </div>
              <h3>历史与数学</h3>
              <p>为什么学一个领域要先看历史和数学。</p>
              <div class="meta"><span>观点</span><span>方法论</span></div>
            </a>
            <a class="card" href="https://github.com/GBLMX?tab=repositories" target="_blank" rel="noopener">
              <div class="top">
                <span class="mono">Code</span>
                <span class="arrow" aria-hidden="true">→</span>
              </div>
              <h3>代码仓库</h3>
              <p>公开的代码与实验，按更新时间排列。</p>
              <div class="meta"><span>GitHub</span></div>
            </a>
          </div>
        </section>

        <section id="picks">
          <div class="sec-head">
            <span class="num" aria-hidden="true">02</span>
            <h2>推荐</h2>
            <span class="hint">用得住才写进来</span>
          </div>
          <div class="picks">
            <article class="pick">
              <div>
                <div class="top">
                  <span class="mono">Agent</span>
                  <span class="url">omp.sh</span>
                </div>
                <h3>omp</h3>
                <p>
                  更新快、功能全：Rust 内核的终端编码 agent，内置 subagents、plan mode、LSP / DAP、记忆与可回滚的规则，工具都按真实会话调过。
                </p>
                <div class="meta"><span>AI</span><span>CLI</span><span>Rust</span></div>
              </div>
              <a class="btn" href="https://omp.sh/" target="_blank" rel="noopener">
                访问 omp.sh
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          </div>
        </section>

        <section id="about">
          <div class="sec-head">
            <span class="num" aria-hidden="true">03</span>
            <h2>关于</h2>
          </div>
          <dl class="ledger">
            <div>
              <dt>定位</dt>
              <dd>长期维护的个人空间。内容优先，尽量给出处。</dd>
            </div>
            <div>
              <dt>书籍页</dt>
              <dd>只收通读过的书，写明作者、版本和推荐理由。</dd>
            </div>
            <div>
              <dt>渲染页</dt>
              <dd>模型可直接拖拽查看；关闭 WebGL 时退回静态预览。</dd>
            </div>
            <div>
              <dt>实现</dt>
              <dd>纯静态页面，无统计脚本，托管在阿里云 ECS。</dd>
            </div>
          </dl>
        </section>

        <section id="contact">
          <div class="sec-head">
            <span class="num" aria-hidden="true">04</span>
            <h2>联系</h2>
          </div>
          <div class="contact">
            <a class="btn" href="mailto:gblmx@bionickernel.com">
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path
                  d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-6.5 3.9a1 1 0 0 1-1 0L1 5.383V12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V5.383Z"
                />
              </svg>
              gblmx@bionickernel.com
            </a>
            <a class="btn" href="https://github.com/GBLMX" target="_blank" rel="noopener">GitHub</a>
            <a class="btn" href="https://space.bilibili.com/500595092" target="_blank" rel="noopener">哔哩哔哩</a>
            <span class="note">邮件优先。</span>
          </div>
        </section>

<Fragment slot="scripts">
  <script src="/assets/fluid.js" defer is:inline></script>
</Fragment>
</BaseLayout>
