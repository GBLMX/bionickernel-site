---
import SubpageLayout from "../../../layouts/SubpageLayout.astro";
---

<SubpageLayout
  title="时空代数动画 — bionickernel.com"
  description="用 Wolfram 计算 Cl(1,3) 的 boost 转子、reversion 与极分解，manimgl 渲染两条 1080p 动画：Lorentz 收缩与 Wigner 旋转。"
  canonical="https://bionickernel.com/research/sta/"
  active="research"
  eyebrow="Research · 2026-10-20"
  heading="时空代数动画"
  lede="两个垂直 boost 复合后，空间部分做极分解 A = R_W S：S 是收缩，R_W 是 Wigner 旋转。数值全部来自 Wolfram Language 15，动画只做插值。"
  ogTitle="时空代数动画 | bionickernel.com"
  ogDescription="Cl(1,3) boost 转子、reversion 与极分解；两条 1080p 动画演示 Lorentz 收缩与 Wigner 旋转。"
  ogType="article"
>
<style is:global>
