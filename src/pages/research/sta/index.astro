    font-size: 0.7rem;
    line-height: 1.7;
    color: #9aa1a6;
  }

  .sta-checks {
    margin-top: 1rem;
    width: 100%;
    max-width: 42rem;
    border-collapse: collapse;
    font-size: 0.86rem;
  }
  .sta-checks th,
  .sta-checks td {
    padding: 0.5rem 0.65rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }
  .sta-checks th {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.7rem;
