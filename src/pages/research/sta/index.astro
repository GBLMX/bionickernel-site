    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--accent-text);
  }
  .sta-head h2 {
    font-size: 1.12rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-transform: none;
    color: var(--fg);
  }
  .sta-sec p {
