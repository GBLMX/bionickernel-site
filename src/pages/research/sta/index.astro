    max-width: 42rem;
    color: var(--dim);
    font-size: 0.94rem;
    line-height: 1.85;
    text-wrap: pretty;
  }
  .sta-intro code {
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--bg-elev);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85em;
    color: var(--fg);
  }

