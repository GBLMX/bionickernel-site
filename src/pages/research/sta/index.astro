    color: var(--dim);
    font-size: 0.9rem;
    line-height: 1.8;
    text-wrap: pretty;
  }

  .sta-fig {
    margin-top: 1rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: #1b1b1b;
    overflow: hidden;
  }
