---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="皮肤渲染 — bionickernel.com" description="本人原创绘制的 Minecraft 皮肤：死灵法师 v5.3 三配色与幽匿（sculk）系列的实时 3D 渲染。" canonical="https://bionickernel.com/skins/" active="skins">
<style is:global>
.lede {
        margin-top: 0.9rem;
        max-width: 42rem;
        color: var(--dim);
        font-size: 0.95rem;
      }
      .lede a,
      .credit a {
        color: var(--fg);
        text-decoration: none;
        border-bottom: 1px solid currentColor;
      }
      .lede a:hover,
      .credit a:hover {
        color: var(--accent-text);
      }
      .credit {
        margin-top: 1.15rem;
        padding: 0.85rem 1rem;
        border: 1px solid var(--border);
        border-left: 2px solid var(--accent);
        border-radius: 10px;
        background: var(--bg-elev);
        font-size: 0.88rem;
        color: var(--dim);
        max-width: 42rem;
      }
      .grid {
        margin-top: 1.4rem;
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      }
      figure {
        margin: 0;
        padding: 0.7rem;
        border: 1px solid var(--border);
        border-radius: 14px;
        background: var(--bg-elev);
      }
      .stage {
        position: relative;
        aspect-ratio: 3 / 4;
        border-radius: 10px;
        overflow: hidden;
        background: linear-gradient(180deg, transparent, rgba(71, 173, 214, 0.06));
      }
      .stage canvas,
      .stage img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
      .stage img {
        position: absolute;
        inset: 0;
        opacity: 0.9;
      }
      .stage canvas {
        position: relative;
        z-index: 1;
        cursor: grab;
      }
      .stage canvas:active {
        cursor: grabbing;
      }
      figcaption {
        margin-top: 0.6rem;
        text-align: center;
        font-size: 0.79rem;
        color: var(--dim);
      }
      @media (prefers-reduced-motion: reduce) {
        .stage canvas {
          cursor: default;
        }
      }
</style>

<p class="mono">Renders</p>
        <h1>皮肤渲染</h1>
        <p class="lede">
          死灵法师 v5.3 三种配色和幽匿（sculk）系列。3D 由
          <a href="https://github.com/bs-community/skinview3d" target="_blank" rel="noopener">skinview3d</a>
          渲染，皮肤由
          <a href="https://github.com/GBLMX/skin-skill" target="_blank" rel="noopener">skin-skill</a>
          生成。可拖拽旋转、滚轮缩放；没有 WebGL 时显示静态图。
        </p>

        <p class="credit">
          皮肤均为本人绘制，源文件和生成工具已开源至
          <a href="https://github.com/GBLMX/skin-skill" target="_blank" rel="noopener">GitHub 仓库</a>。
        </p>

        <div class="grid">
          <figure data-skin="/assets/skins/tex/v5_3.png">
            <div class="stage">
              <canvas aria-label="死灵法师 v5.3 原色配色 3D 模型"></canvas>
              <img src="/assets/skins/v5_3.png" alt="死灵法师 v5.3 原色配色静态预览" width="90" height="204" loading="lazy" decoding="async" />
            </div>
            <figcaption>v5.3 原色</figcaption>
          </figure>
          <figure data-skin="/assets/skins/tex/v5_3_green.png">
            <div class="stage">
              <canvas aria-label="死灵法师 v5.3 绿色配色 3D 模型"></canvas>
              <img src="/assets/skins/v5_3_green.png" alt="死灵法师 v5.3 绿色配色静态预览" width="90" height="204" loading="lazy" decoding="async" />
            </div>
            <figcaption>v5.3 绿</figcaption>
          </figure>
          <figure data-skin="/assets/skins/tex/v5_3_red.png">
            <div class="stage">
              <canvas aria-label="死灵法师 v5.3 红色配色 3D 模型"></canvas>
              <img src="/assets/skins/v5_3_red.png" alt="死灵法师 v5.3 红色配色静态预览" width="90" height="204" loading="lazy" decoding="async" />
            </div>
            <figcaption>v5.3 红</figcaption>
          </figure>
          <figure data-skin="/assets/skins/tex/sculk.png">
            <div class="stage">
              <canvas aria-label="死灵法师幽匿配色 3D 模型"></canvas>
              <img src="/assets/skins/sculk.png" alt="死灵法师幽匿配色静态预览" width="90" height="204" loading="lazy" decoding="async" />
            </div>
            <figcaption>sculk 幽匿</figcaption>
          </figure>
          <figure data-skin="/assets/skins/tex/sculk_light.png">
            <div class="stage">
              <canvas aria-label="死灵法师幽匿 light 档配色 3D 模型"></canvas>
              <img src="/assets/skins/sculk_light.png" alt="死灵法师幽匿 light 档配色静态预览" width="90" height="204" loading="lazy" decoding="async" />
            </div>
            <figcaption>sculk light</figcaption>
          </figure>
        </div>

<Fragment slot="scripts">
  <script src="/assets/skinview3d.bundle.js" is:inline></script>
  <script is:inline>

      (function () {
        if (typeof skinview3d === "undefined") return;
        var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        document.querySelectorAll("figure[data-skin]").forEach(function (figure) {
          var canvas = figure.querySelector("canvas");
          var fallback = figure.querySelector("img");
          var stage = figure.querySelector(".stage");
          try {
            var viewer = new skinview3d.SkinViewer({
              canvas: canvas,
              width: stage.clientWidth,
              height: stage.clientHeight,
              pixelRatio: "match-device",
              skin: figure.dataset.skin,
              model: "auto-detect",
              zoom: 0.82,
            });
            viewer.autoRotate = !reduceMotion;
            viewer.autoRotateSpeed = 0.7;
            if (!reduceMotion) viewer.animation = new skinview3d.IdleAnimation();
            viewer.controls.enablePan = false;
            viewer.controls.minDistance = 25;
            viewer.controls.maxDistance = 90;
            if (window.ResizeObserver) {
              new ResizeObserver(function () {
                viewer.setSize(stage.clientWidth, stage.clientHeight);
              }).observe(stage);
            }
            fallback.style.display = "none";
          } catch (err) {
            /* keep the static preview */
          }
        });
      })();
  </script>
</Fragment>
</BaseLayout>
